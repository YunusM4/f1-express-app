<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <title>F1 App - Registreren</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
</head>
<body>
    <div class="auth-container">
        <h1>F1 App</h1>
        <h2>Registreren</h2>

        <% if (message) { %>
            <p class="message <%= message.type %>"><%= message.message %></p>
        <% } %>

        <form method="POST" action="/register">
            <div class="form-group">
                <label>Username</label>
                <input type="text" name="username" placeholder="Kies een username" required>
            </div>
            <div class="form-group">
                <label>Wachtwoord</label>
                <input type="password" name="password" placeholder="Kies een wachtwoord" required>
            </div>
            <button type="submit">Registreren</button>
        </form>
        <p style="margin-top:16px; font-size:14px;">
            Al een account? <a href="/login">Log hier in</a>
        </p>
    </div>
</body>
</html>